{
  "name": "devmind-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^12.0.0"
  },
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm -r --filter=!./evals/** run build",
    "build:client": "pnpm --filter client build",
    "build:extension": "pnpm --filter devmind-vscode build",
    "package:extension": "pnpm --filter devmind-vscode package",
    "deploy:client": "npx --yes vercel deploy client --prod",
    "deploy:client:preview": "npx --yes vercel deploy client",
    "docker:build:server": "docker build -t devmind-server:latest -f server/Dockerfile server",
    "validate:env": "node scripts/validate-env.mjs",
    "db:migrate": "cd server && uv run alembic upgrade head",
    "db:seed": "cd server && uv run python -m app.core.bootstrap",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r --filter=!./evals/** run test",
    "test:e2e": "pnpm --filter client test:e2e",
    "test:all": "node scripts/test-all.mjs",
    "verify": "node scripts/test-all.mjs --fast",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/sync-brand.mjs --check",
    "docs:links": "node scripts/docs-links.mjs",
    "docs:audit": "node scripts/docs-links.mjs",
    "eval:retrieval": "python3 evals/retrieval/harness.py",
    "eval:llm": "server/.venv/bin/python evals/llm/harness.py",
    "eval:pr": "server/.venv/bin/python evals/pr_intelligence/harness.py",
    "eval:bug-docs": "server/.venv/bin/python evals/bug_docs/harness.py",
    "eval:mentor": "server/.venv/bin/python evals/mentor/harness.py",
    "gen:api": "server/.venv/bin/python scripts/export-openapi.py && pnpm --filter @devmind/common exec openapi-typescript openapi.json -o src/api/schema.d.ts && pnpm --filter @devmind/common build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@devmind/common": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.5"
  }
}
