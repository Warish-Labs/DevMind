# DevMind — server/.env.example
# FastAPI + Celery backend variables (Render free web service)
#
# Copy to server/.env for local development. Never commit server/.env.
# Use `openssl rand -base64 32` to generate self-generated secrets.
#
# Milestone key:
#   M1  = Milestone 1 (server foundation, Docker, configuration)
#   M2  = Milestone 2 (auth, workspaces, projects)
#   M3  = Milestone 3 (extension real local scanning)
#   M5  = Milestone 5 (indexed mode, embeddings, retrieval)
#   M6  = Milestone 6 (LLM gateway and config)
#   M10 = Milestone 10 (hardening, observability)
#   M11 = Milestone 11 (GitHub, PR Intelligence)
#
# See: docs/SETUP-GUIDE.md §7 and docs/10-deployment-and-operations.md §11

# ---------------------------------------------------------------------------
# Core environment [M1]
# ---------------------------------------------------------------------------

# Which environment this is: local | test | staging | production
# Controls validation strictness (e.g. placeholder keys fail in production).
DEVMIND_ENV=local

# Which process(es) to run in this container: api | worker | scheduler | all
# Use "all" for the free Render profile (one web service, no background workers).
# Use "api" locally when running API and worker separately.
DEVMIND_RUN_MODE=all

# Log level: DEBUG | INFO | WARNING | ERROR
DEVMIND_LOG_LEVEL=INFO

# Short prefix for all Redis keys (e.g. "dm:" or "devmind:").
# Required when sharing a Redis instance across environments. Keep it short.
DEVMIND_REDIS_KEY_PREFIX=dm:

# ---------------------------------------------------------------------------
# PostgreSQL (Neon) [M1]
# How to get: neon.tech → Create project → Connection string
#   Pooled endpoint: for the API service (connection pooling via PgBouncer)
#   Direct endpoint: for migrations (Alembic) and LangGraph checkpointer
#
# The pooled URL uses port 5432 via PgBouncer; the direct URL uses port 5432
# on the direct endpoint hostname. See docs/SETUP-GUIDE.md §6.2.
# ---------------------------------------------------------------------------

DEVMIND_DATABASE_URL=postgresql+psycopg://devmind_app:REPLACE_ME@REPLACE_ME.neon.tech:5432/devmind?sslmode=require
DEVMIND_DATABASE_URL_DIRECT=postgresql+psycopg://devmind_migrate:REPLACE_ME@REPLACE_ME.neon.tech:5432/devmind?sslmode=require

# ---------------------------------------------------------------------------
# Redis (Upstash Redis — free tier, standard Redis TLS protocol) [M1]
# How to get: console.upstash.com → Create Redis Database → Connect → Native / redis-cli URI
# Example production: rediss://default:REPLACE_ME@REPLACE_ME.upstash.io:6379
# Locally: use Docker Compose (infra/docker-compose.yml) → redis://localhost:6379/0
# NOTE: Do NOT use the Upstash HTTP REST URL. redis-py and Celery require standard rediss://
# ---------------------------------------------------------------------------

DEVMIND_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Clerk authentication [M2]
# How to get: clerk.com → Create application → API Keys
#   Secret key: Dashboard → API Keys → Secret key (starts with sk_test_ or sk_live_)
#   Publishable key: Dashboard → API Keys → Publishable key (starts with pk_test_ or pk_live_)
#   Webhook secret: Dashboard → Webhooks → Add endpoint → Signing secret
# ---------------------------------------------------------------------------

CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
DEVMIND_CLERK_ISSUER=https://clerk.devmind.warishlabs.in
DEVMIND_CLERK_JWKS_URL=https://clerk.devmind.warishlabs.in/.well-known/jwks.json
DEVMIND_CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://devmind.warishlabs.in


# ---------------------------------------------------------------------------
# CORS (allowed origins for the API) [M2]
# Comma-separated list. Local: http://localhost:3000
# Production: https://devmind.warishlabs.in (ADR-049)
# ---------------------------------------------------------------------------

DEVMIND_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Encryption and token security [M2]
# Generate with: openssl rand -base64 32
# DEVMIND_ENCRYPTION_KEYS: JSON array of base64 keys; first key is current, rest are for rotation.
# DEVMIND_EXT_TOKEN_PEPPER: fixed pepper for hashing extension tokens (HMAC-SHA256).
#   Rotate by adding a new key and re-hashing — see docs/runbooks/secrets-rotation.md.
# ---------------------------------------------------------------------------

DEVMIND_ENCRYPTION_KEYS=["REPLACE_WITH_openssl_rand_-base64_32"]
DEVMIND_EXT_TOKEN_PEPPER=REPLACE_WITH_openssl_rand_-base64_32

# ---------------------------------------------------------------------------
# LLM and embedding providers [M5/M6]
#
# Default: "fake" provider (no key needed; used for tests, CI and demos).
# Free option: Google AI Studio (free tier) — see docs/SETUP-GUIDE.md §6.4.
#   How to get: aistudio.google.com → Get API key (free, no credit card)
#   Note: Google AI Studio free tier may use submitted data to improve products.
#   ADR-048: use synthetic fixtures or public code only on free tiers.
#
# The provider name must match an entry in server/configs/llm/providers.yaml.
# Models are configured per task in server/configs/llm/tasks.yaml.
# ---------------------------------------------------------------------------

# Generation provider (default: fake — no key required for local/CI)
DEVMIND_LLM_PROVIDER=fake
DEVMIND_LLM_API_KEY=REPLACE_ME_or_leave_blank_for_fake_provider

# Embedding provider (default: fake — no key required for local/CI)
DEVMIND_EMBED_PROVIDER=fake
DEVMIND_EMBED_API_KEY=REPLACE_ME_or_leave_blank_for_fake_provider

# Embedding space identifier (must match server/configs/llm/embedding_spaces.yaml)
# DEVMIND_EMBED_SPACE_ID=default-768

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage [M1]
# How to get: cloudflare.com → R2 → Manage R2 API tokens → Create API token
# Note: R2 free tier is 10 GB storage + 1M Class A ops/month. May be skipped
#       for initial free-profile deployment if no artifact storage is needed yet.
# ADR-013: R2 confirmed. If skipping for now, leave these as placeholders;
#           the server will disable R2 upload paths.
# ---------------------------------------------------------------------------

DEVMIND_R2_ACCOUNT_ID=REPLACE_ME
DEVMIND_R2_ACCESS_KEY_ID=REPLACE_ME
DEVMIND_R2_SECRET_ACCESS_KEY=REPLACE_ME
DEVMIND_R2_BUCKET_NAME=devmind-artifacts-local

# ---------------------------------------------------------------------------
# GitHub integration [M11 — Release 1.1]
# How to get: github.com → Settings → Developer settings → OAuth Apps → New OAuth App
#   Application name: DevMind (local) / DevMind
#   Homepage URL: http://localhost:3000
#   Authorization callback URL: http://localhost:8000/api/v1/integrations/github/callback
# Webhook secret: openssl rand -base64 32 (set on the GitHub App later)
# ---------------------------------------------------------------------------

DEVMIND_GITHUB_CLIENT_ID=REPLACE_ME
DEVMIND_GITHUB_CLIENT_SECRET=REPLACE_ME
DEVMIND_GITHUB_WEBHOOK_SECRET=REPLACE_ME

# ---------------------------------------------------------------------------
# Email (Resend) [M11 — Release 1.1]
# How to get: resend.com → Create account → API Keys → Create API Key
# Free tier: 3,000 emails/month, 100/day.
# Requires a verified domain (warishlabs.in in your case).
# ---------------------------------------------------------------------------

DEVMIND_RESEND_API_KEY=re_REPLACE_ME
DEVMIND_EMAIL_FROM=DevMind <invitations@warishlabs.in>
DEVMIND_APP_BASE_URL=https://devmind.warishlabs.in

# ---------------------------------------------------------------------------
# Cloudflare Turnstile secret key [M8 / Public Forms]
# How to get: dash.cloudflare.com → Turnstile → Select Widget (DevMind Production) → Secret Key
#
# Cloudflare Turnstile secret key.
# Local: use a matching test secret or a dedicated development widget secret.
#   Dummy test secret (always passes): 1x0000000000000000000000000000000AA
#   Dummy test secret (always fails): 2x0000000000000000000000000000000AA
#   Dummy test secret (token spent): 3x0000000000000000000000000000000AA
# Production: use the secret key for the DevMind Production widget.
# PRIVATE: never expose this value in frontend code or commit a real secret.
# ---------------------------------------------------------------------------

DEVMIND_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------------------------------------------------------------------------
# Kill switches (set to "true" to disable a subsystem at runtime) [M1]
# Useful during incidents or when rate limits are hit.
# ---------------------------------------------------------------------------

DEVMIND_KILL_INDEXING=false
DEVMIND_KILL_LLM=false
DEVMIND_KILL_EMBED=false
DEVMIND_KILL_WEBHOOKS=false
DEVMIND_PAUSE_QUEUES=false

# ---------------------------------------------------------------------------
# Observability & Alerting Thresholds [M10]
# OpenTelemetry traces & metrics (docs/02 §12, docs/10 §13, ADR-030).
# Error reporting is optional free-tier compatible (OQ-15, ADR-046); leave blank
# to use local structured logging exclusively.
# Alerting thresholds trigger warnings when breached (docs/10 §14, §15, §18).
# ---------------------------------------------------------------------------

DEVMIND_OTEL_SERVICE_NAME=devmind-api
DEVMIND_OTEL_EXPORTER=memory
DEVMIND_SENTRY_DSN=

DEVMIND_ALERT_MAX_QUEUE_DEPTH=500
DEVMIND_ALERT_MAX_QUEUE_AGE_SECONDS=300
DEVMIND_ALERT_MAX_HEARTBEAT_STALE_SECONDS=120
DEVMIND_ALERT_MAX_ERROR_RATE_PERCENT=5.0

# Build SHA / commit reference returned by /healthz liveness probe (docs/10 §12)
DEVMIND_BUILD_SHA=dev

