{
  "name": "devmind-vscode",
  "displayName": "DevMind Companion",
  "description": "Continuous Project Brain Companion for VS Code: local scanner, architectural map, and privacy-first sync.",
  "version": "0.1.0",
  "publisher": "WarishLabs",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Education"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Warish-Labs/DevMind.git",
    "directory": "extension"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devmind.scanWorkspace",
        "title": "DevMind: Scan Workspace",
        "category": "DevMind"
      },
      {
        "command": "devmind.cancelScan",
        "title": "DevMind: Cancel Active Scan",
        "category": "DevMind"
      },
      {
        "command": "devmind.openFindings",
        "title": "DevMind: Open Findings View",
        "category": "DevMind"
      },
      {
        "command": "devmind.showLogs",
        "title": "DevMind: Show Output Channel",
        "category": "DevMind"
      },
      {
        "command": "devmind.syncNow",
        "title": "DevMind: Sync with Project Brain",
        "category": "DevMind"
      },
      {
        "command": "devmind.syncProject",
        "title": "DevMind: Sync Project Metadata",
        "category": "DevMind"
      },
      {
        "command": "devmind.linkProject",
        "title": "DevMind: Link Workspace to Project",
        "category": "DevMind"
      },
      {
        "command": "devmind.showWhatLeaves",
        "title": "DevMind: Review What Leaves Machine",
        "category": "DevMind"
      },
      {
        "command": "devmind.reviewSync",
        "title": "DevMind: Review What Leaves Machine (Consent Preview)",
        "category": "DevMind"
      },
      {
        "command": "devmind.refreshAll",
        "title": "DevMind: Refresh All Views",
        "category": "DevMind"
      },
      {
        "command": "devmind.signIn",
        "title": "DevMind: Sign In",
        "category": "DevMind"
      },
      {
        "command": "devmind.signOut",
        "title": "DevMind: Sign Out",
        "category": "DevMind"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devmind-activitybar",
          "title": "DevMind",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "devmind-activitybar": [
        {
          "id": "devmind.views.findings",
          "name": "Findings"
        },
        {
          "id": "devmind.views.structure",
          "name": "Project Structure"
        },
        {
          "id": "devmind.views.scan",
          "name": "Scan Status"
        },
        {
          "id": "devmind.views.sync",
          "name": "Sync & Privacy"
        },
        {
          "id": "devmind.views.database",
          "name": "Database (from files)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devmind.views.findings",
        "contents": "No architectural or authorization findings detected in workspace.\n[Scan Workspace](command:devmind.scanWorkspace)\n[Open Logs](command:devmind.showLogs)"
      },
      {
        "view": "devmind.views.structure",
        "contents": "No project modules or endpoints detected.\nRun a scan to extract routes and guard chains.\n[Scan Workspace](command:devmind.scanWorkspace)"
      },
      {
        "view": "devmind.views.scan",
        "contents": "Open a workspace folder to run local architectural analysis.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "devmind.views.sync",
        "contents": "DevMind operates in privacy-first mode (ADR-022).\nSource code stays local unless explicit consent is provided.\n[Review Privacy Ledger](command:devmind.showWhatLeaves)"
      },
      {
        "view": "devmind.views.database",
        "contents": "Discovered statically from files (Prisma, SQLAlchemy, migrations).\nZero live database connections (ADR-034).\n[Scan Workspace](command:devmind.scanWorkspace)"
      }
    ],
    "configuration": {
      "title": "DevMind",
      "properties": {
        "devmind.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8000/api/v1",
          "scope": "machine",
          "description": "Base URL of the DevMind server API."
        },
        "devmind.fixtureMode": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Use local fixtures for findings and project structure without requiring server connection."
        },
        "devmind.syncMode": {
          "type": "string",
          "enum": [
            "metadata_only",
            "indexed",
            "disabled"
          ],
          "default": "metadata_only",
          "scope": "resource",
          "description": "Synchronization mode governing what information can be transmitted with consent."
        },
        "devmind.projectId": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Active DevMind project UUID linked to this workspace folder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --out dist/devmind-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
