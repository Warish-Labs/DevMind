# DevMind — extension/.env.example
# VS Code extension — build-time variables only.
#
# The extension has NO runtime secrets. All credentials (API tokens, refresh tokens)
# are stored in VS Code's SecretStorage (encrypted, per-machine keychain).
#
# These variables are for local development and CI builds only.
# Copy to extension/.env for local use. Never commit extension/.env.

# API base URL used during development (overridden by user setting devmind.apiBaseUrl)
# Note: in production the extension reads this from VS Code settings (machine scope only).
# DEVMIND_API_BASE_URL=http://localhost:8000

# Set to "true" to build with fixture mode enabled by default.
# In production, this is controlled by the devmind.fixtureMode VS Code setting.
# DEVMIND_FIXTURE_MODE_DEFAULT=true
