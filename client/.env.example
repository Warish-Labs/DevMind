# DevMind — client/.env.example
# Next.js client variables (Vercel Hobby deployment)
#
# Copy to client/.env.local for local development. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are bundled into the browser; keep them non-secret.
#
# Milestone key:
#   P0  = available from Phase P0 (no external service needed)
#   M2  = required from Milestone M2 (auth, workspaces)
#   M8  = required from Milestone M8 (website app)

# ---------------------------------------------------------------------------
# Site configuration [P0]
# ---------------------------------------------------------------------------

# The canonical public URL of this Next.js deployment.
# Local: http://localhost:3000   Production: https://devmind.warishlabs.in  (ADR-049)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The base URL of the DevMind API server.
# Local: http://localhost:8000   Production: https://api.devmind.warishlabs.in  (ADR-049)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Clerk authentication [M2]
# How to get: clerk.com → Create application → API Keys
# Publishable key is safe to expose to the browser.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Clerk frontend API URL (usually auto-detected, but set explicitly if using a custom domain)
# NEXT_PUBLIC_CLERK_FRONTEND_API=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile [M8 / Public Forms]
# How to get: dash.cloudflare.com → Turnstile → Add site (Widget: DevMind Production)
#
# Cloudflare Turnstile site key.
# Local: use a Cloudflare test site key or a dedicated development widget.
#   Dummy test key (always passes): 1x00000000000000000000AA
#   Dummy test key (always blocks): 2x00000000000000000000AB
# Production: use the site key for the DevMind Production widget (hostname: devmind.warishlabs.in).
# This is public and may be exposed to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---------------------------------------------------------------------------
# Feature flags (optional, local overrides) [P0]
# ---------------------------------------------------------------------------

# Set to "true" to enable fixture/demo mode regardless of server setting.
# NEXT_PUBLIC_FIXTURE_MODE=false

