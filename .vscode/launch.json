{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch DevMind Extension (express-admin fixture)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/evals/scanner/fixtures/express-admin"
      ],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "build:extension"
    },
    {
      "name": "Launch DevMind Extension (fastapi-admin fixture)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/evals/scanner/fixtures/fastapi-admin"
      ],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "build:extension"
    }
  ]
}
